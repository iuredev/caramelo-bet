{
    "Seq": {
        "ServerUrl": "http://localhost:5341"
    },
    "ReverseProxy": {
        "Routes": {
            "api-route": {
                "ClusterId": "api-cluster",
                "Match": {
                    "Path": "/api/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "api-cluster": {
                "Destinations": {
                    "api-destination": {
                        "Address": "http://localhost:5057"
                    }
                }
            }
        }
    },
    "Jaeger": {
        "Endpoint": "http://localhost:4317"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "AllowedHosts": "*"
}
